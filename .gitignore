# ==========================================
# Root .gitignore for MillTrack Monorepo
# ==========================================

# Environment variables & credentials
.env
.env.*
*.env
!*.env.example

# Compiled Binaries & Packages
*.exe
*.dll
*.so
*.dylib
*.zip
*.tar.gz
*.rar

# Node / Frontend artifacts
node_modules/
dist/
dist-ssr/
build/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*

# Flutter / Dart artifacts
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
android/build/
ios/Flutter/Generated.xcconfig

# User-generated uploads & media
backend/upload/*
!backend/upload/.gitkeep

# IDEs & Editor configs
.idea/
.vscode/*
!.vscode/extensions.json
*.iml
*.ipr
*.iws
*.swp
*.swo

# Operating System files
.DS_Store
Thumbs.db
ehthumbs.db

# Agent skills workspace directory
skills/
